// ticket_to_pr: one GitHub issue in, one tested pull request out.
// Started by SuperPlane (factory/superplane/) with the issue as run inputs.
// Docs: https://docs.fabro.sh/reference/dot-language
digraph TicketToPr {
    graph [
        goal="Resolve GitHub issue #{{ inputs.issue_number }} in {{ inputs.repo }}: {{ inputs.issue_title }}",
        // Planning is cheap and read-only, so Haiku; writing code is Sonnet.
        model_stylesheet="
            *         { model: claude-sonnet-5-5; }
            .planning { model: claude-haiku-5-5; reasoning_effort: high; }
            .coding   { model: claude-sonnet-5-5; reasoning_effort: medium; }
        ",
        // Any failure without an explicit route below ends the run as failed.
        on_failure="exit",
        // Hard cap on any one node; the per-node limits below are tighter.
        max_node_visits=10
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Reads the issue and the code, writes plan.md, and routes Ready or Ask.
    // Bounded so a question/answer loop can't run forever.
    plan [label="Plan", class="planning", prompt="@prompts/plan.md",
          output_schema="routing", max_visits=3]

    // Freeform question. SuperPlane posts it as an issue comment and sends the
    // reply back through POST /runs/{id}/questions/{qid}/answer.
    clarify [shape=hexagon, label="The planner needs an answer before it can continue (see its question above)"]

    setup [label="Install dependencies",
           script="python -m pip install -q -r requirements.txt -r requirements-dev.txt"]

    implement [label="Implement", class="coding", prompt="@prompts/implement.md"]

    // The same gate CI enforces: the full nose suite plus the 90% coverage floor
    // (Makefile COVERAGE_FLOOR). The run cannot succeed unless this does.
    test [label="Run tests", goal_gate=true,
          script="nosetests tests --with-coverage --cover-package=orderdesk --cover-erase && coverage report --include='orderdesk/*' --fail-under=90"]

    // At most 3 repair attempts; a 4th failing test run ends the run.
    fix [label="Fix", class="coding", prompt="@prompts/fix.md", max_visits=3]

    start -> plan
    plan -> clarify [label="Ask", condition="preferred_label=Ask"]
    plan -> setup   [label="Ready"]
    clarify -> plan [freeform=true]
    setup -> implement -> test
    test -> fix  [condition="outcome=failed"]
    // Fallback for every other outcome; the goal gate still fails the run
    // unless the tests passed.
    test -> exit
    fix -> test
}
